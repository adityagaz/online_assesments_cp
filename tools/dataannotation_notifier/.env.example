# Copy this file to ".env" (same folder) and fill it in.

# --- Email (Gmail example) ---
# Use a Gmail "App Password", NOT your normal password:
#   Google Account -> Security -> 2-Step Verification (turn on) -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
# Where alerts go (comma-separated for several addresses)
EMAIL_TO=yourgmail@gmail.com

# --- Checking ---
# Seconds between checks (a random +-20% is added so it doesn't look robotic).
# 120-300 is reasonable; don't hammer the site.
CHECK_INTERVAL_SECONDS=180
# Set to 0 to watch the browser window while it checks (useful for debugging)
HEADLESS=1
